# Copy this file to .env and paste your key. .env is git-ignored and never logged.
#
# Get a Gemini API key at: https://aistudio.google.com/apikey
# (sign in with a Google account, click "Create API key", copy the string that
# starts with "AIza...")
GEMINI_API_KEY=AIza...

# Optional overrides
PM4_MODEL=gemini-3.1-flash-lite
PM4_LOG_SALT=change-me-per-deployment
